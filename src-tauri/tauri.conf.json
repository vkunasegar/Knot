{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KNOT",
  "version": "0.1.0",
  "identifier": "io.github.vkunasegar.knot",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KNOT",
        "width": 1440,
        "height": 900,
        "label": "main",
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "preventOverflow": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#F7F5F0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
      "capabilities": [
        "main-window"
      ]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
