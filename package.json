{
  "name": "knot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "pnpm check && vite build",
    "check": "tsc --noEmit && tsc --project tsconfig.node.json && tsc --project tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:linux": "node scripts/check-linux.mjs",
    "setup:agent-host": "node scripts/install-agent-host-bridge.mjs",
    "test": "vitest run",
    "test:ui": "pnpm build:web --mode test && playwright test",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.0.16",
    "vitest": "5.1.0"
  }
}
